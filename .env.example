# Copy to .env and fill in:  cp .env.example .env
# Required: LLM_API_KEY and JWT_SECRET. Everything else has a sensible default (see backend/app/config.py).

# ---------- LLM: any OpenAI-compatible API ----------
# Gemini (free tier; key from https://aistudio.google.com/apikey)
LLM_PROVIDER=openai_compatible
LLM_API_KEY=your-gemini-key
LLM_BASE_URL=https://generativelanguage.googleapis.com/v1beta/openai/
CHAT_MODEL=gemini-2.5-flash
EMBED_MODEL=gemini-embedding-001
EMBED_DIM=768
PRICE_INPUT_PER_M=0.30
PRICE_OUTPUT_PER_M=2.50
# No key at all? LLM_PROVIDER=fake runs a deterministic stand-in (for testing the plumbing)

# ---------- Speech-to-text for recordings (optional) ----------
# Free Groq key from https://console.groq.com/keys. Without it, upload text transcripts (.txt/.vtt/.srt).
STT_API_KEY=
STT_BASE_URL=https://api.groq.com/openai/v1
STT_MODEL=whisper-large-v3-turbo
# OpenAI instead: STT_BASE_URL=https://api.openai.com/v1  STT_MODEL=whisper-1

# ---------- Auth (required) ----------
# Generate with: python3 -c "import secrets; print(secrets.token_urlsafe(48))"
JWT_SECRET=replace-me

# ---------- Email ----------
# console = only log emails (safe default for demos). smtp = really send.
EMAIL_BACKEND=console
# Gmail: turn on 2-Step Verification, create an App Password at https://myaccount.google.com/apppasswords
# SMTP_HOST=smtp.gmail.com
# SMTP_PORT=587
# SMTP_USERNAME=you@gmail.com
# SMTP_PASSWORD=your-16-char-app-password
# EMAIL_FROM=you@gmail.com

# ---------- Agent ----------
TIMEZONE=Asia/Kolkata          # reminders are scheduled at 09:00 in this time zone
AGENT_MAX_STEPS=8              # hard limit on agent loop iterations

# ---------- Webhooks (optional) ----------
# Set to enable POST /webhooks/meetings. Generate like JWT_SECRET.
WEBHOOK_SECRET=

# ---------- Infrastructure (defaults match docker compose; only change for local dev without Docker) ----------
# DATABASE_URL=postgresql://actionpilot:actionpilot@localhost:5434/actionpilot
# REDIS_URL=redis://localhost:6380/0
# QUEUE_BACKEND=rq             # rq = Redis worker with retries; background = in-process, no Redis
